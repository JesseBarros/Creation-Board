# Dependencias e artefatos de build
node_modules/
out/
release/
release-gpu/
dist/
*.tsbuildinfo

# Configuracao local de ferramentas de desenvolvimento.
#
# Fica aqui, e nao so no ignore global de quem escreveu: um arquivo de
# configuracao local costuma guardar caminhos absolutos da maquina, e depender do
# ignore global significa que ele vaza no primeiro clone feito em outro lugar.
.vscode/
.idea/

# Segredos e credenciais. O app nao usa nenhum; isto impede que um caia aqui
# por engano (o token da assinatura, por exemplo, mora nos segredos do GitHub).
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.secret
*.token
credentials*.json
secrets*.json

# Logs, temporarios e ambientes de outras linguagens
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
.venv/
venv/
__pycache__/
*.pyc
coverage/
.cache/

# Copias de seguranca do historico do git
*.bundle

# Ruido do sistema operacional
.DS_Store
Thumbs.db
desktop.ini
